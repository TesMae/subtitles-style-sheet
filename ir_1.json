{
  "globalStyle":
    [
      {
        "Default": {
          "fontFamily": "Arial",
          "fontSize": 20,
          "color": "rgba(255, 255, 255, 1)",
          "karaokeSecondaryColor": "rgba(255, 0, 0, 1)",
          "textStrokeColor": "rgba(0, 0, 0, 1)",
          "boxBackgroundColor": "rgba(0, 0, 0, 1)",
          "textDecoration": "none",
          "transform": {
            "scaleX": 1,
            "scaleY": 1,
            "rotate": 0
          },
          "letterSpacing": 0,
          "borderStyle": "outline-shadow",
          "textStrokeWidth": 2,
          "textShadowDepth": 0,
          "alignment": "middle-center",
          "positionAnchor": "center",
          "marginLeft": 10,
          "marginRight": 10,
          "marginVertical": 540,
          "encoding": "ansi"
        }
      }
    ],
  "subtitles": [
    {
      "_id": 0,
      "start": 0,
      "end": 3,
      "text": "Welcome to this amazing tutorial",
      "style": "Default",
      "zIndex": 0,
      "margin": { "left": 0, "right": 0, "vertical": 0 },
      "wordStyles": {
        "0": { "bold": true, "fontFamily": "Arial" },
        "3": { "color": "yellow", "fontSize": 100 }
      }
    },
    {
      "_id": 1,
      "start": 4,
      "end": 7,
      "text": "Full color layer control",
      "style": "Default",
      "zIndex": 0,
      "margin": { "left": 0, "right": 0, "vertical": 0 },
      "wordStyles": {
        "0": {
          "color": "#00FFFF",
          "secondaryColor": "#FF0000",
          "outlineColor": "#000000",
          "shadowColor": "#444444",
          "opacity": 0.9,
          "fillOpacity": 1,
          "secondaryOpacity": 0.5,
          "outlineOpacity": 0.8,
          "shadowOpacity": 0.3
        }
      }
    },
    {
      "_id": 2,
      "start": 8,
      "end": 11,
      "text": "Bold italic underline strikeout",
      "style": "Default",
      "zIndex": 0,
      "margin": { "left": 0, "right": 0, "vertical": 0 },
      "wordStyles": {
        "0": { "bold": true, "fontSize": 30, "fontFamily": "Times New Roman" },
        "1": { "italic": true, "letterSpacing": 4 },
        "2": { "underline": true },
        "3": { "strikeout": true, "fontEncoding": 1 }
      }
    },
    {
      "_id": 3,
      "start": 12,
      "end": 15,
      "text": "Positioned and rotated",
      "style": "Default",
      "zIndex": 2,
      "margin": { "left": 0, "right": 0, "vertical": 0 },
      "position": { "x": 540, "y": 300 },
      "rotationOrigin": { "x": 540, "y": 300 },
      "transform": { "scaleX": 1.5, "scaleY": 1.5, "rotate": -10, "rotateX": 0, "rotateY": 0 },
      "alignment": "top-center"
    },
    {
      "_id": 4,
      "start": 16,
      "end": 19,
      "text": "Moving across the screen",
      "style": "Default",
      "zIndex": 0,
      "margin": { "left": 0, "right": 0, "vertical": 0 },
      "move": { "x1": 0, "y1": 1920, "x2": 1080, "y2": 0 }
    },
    {
      "_id": 5,
      "start": 20,
      "end": 23,
      "text": "Thick border deep shadow",
      "style": "Default",
      "zIndex": 0,
      "margin": { "left": 0, "right": 0, "vertical": 0 },
      "border": { "width": 4, "widthX": 5, "widthY": 2 },
      "shadow": { "depth": 6, "depthX": 7, "depthY": 3 },
      "blur": { "edgeBlur": true, "gaussianBlur": 1.5 }
    },
    {
      "_id": 6,
      "start": 24,
      "end": 29,
      "text": "Animated transition then fade",
      "style": "Default",
      "zIndex": 0,
      "margin": { "left": 0, "right": 0, "vertical": 0 },
      "animation": {
        "fadeInMs": 300,
        "fadeOutMs": 500,
        "fadeComplex": {
          "a1": 0,
          "a2": 0.5,
          "a3": 1,
          "t1": 0,
          "t2": 500,
          "t3": 4000,
          "t4": 5000
        },
        "transitions": [
          {
            "accelerator": 1,
            "startMs": 500,
            "endMs": 2500,
            "to": { "color": "#FF0000", "fontSize": 40 }
          }
        ]
      }
    },
    {
      "_id": 7,
      "start": 30,
      "end": 33,
      "text": "Text inside clipped region",
      "style": "Default",
      "zIndex": 0,
      "margin": { "left": 0, "right": 0, "vertical": 0 },
      "clip": {
        "type": "rect",
        "inverse": false,
        "x1": 100,
        "y1": 100,
        "x2": 980,
        "y2": 800
      }
    },
    {
      "_id": 8,
      "start": 34,
      "end": 37,
      "text": "Vector drawing replaces text",
      "style": "Default",
      "zIndex": 0,
      "margin": { "left": 0, "right": 0, "vertical": 0 },
      "drawing": {
        "scale": 2,
        "baselineOffset": 5,
        "commands": "m 0 0 b 10 0 10 10 20 10"
      }
    },
    {
      "_id": 9,
      "start": 38,
      "end": 42,
      "text": "Hello world karaoke time",
      "style": "Default",
      "zIndex": 0,
      "margin": { "left": 0, "right": 0, "vertical": 0 },
      "wordStyles": {
        "0": { "karaoke": { "type": "fill", "durationMs": 400 } },
        "1": { "karaoke": { "type": "fill", "durationMs": 200 } },
        "2": { "karaoke": { "type": "sweepFill", "durationMs": 300 } },
        "3": { "karaoke": { "type": "sweepOutline", "durationMs": 500 } }
      }
    },
    {
      "_id": 10,
      "start": 43,
      "end": 48,
      "text": "Danger danger ahead normal",
      "style": "Default",
      "zIndex": 0,
      "margin": { "left": 0, "right": 0, "vertical": 0 },
      "wordStyles": {
        "0": { "bold": true, "color": "#FF0000" },
        "1": { "bold": true, "color": "#FF0000" },
        "2": { "reset": true }
      },
      "wrapMode": 2
    },
    {
      "_id": 11,
      "start": 49,
      "end": 55,
      "text": "This text scrolls upward",
      "style": "Default",
      "zIndex": 0,
      "margin": { "left": 0, "right": 0, "vertical": 0 },
      "effect": { "type": "scrollUp", "y1": 100, "y2": 1500, "delay": 3, "fadeaway": 50 }
    },
    {
      "_id": 12,
      "start": 56,
      "end": 62,
      "text": "Banner scroll across the bottom",
      "style": "Default",
      "zIndex": 0,
      "margin": { "left": 0, "right": 0, "vertical": 0 },
      "effect": { "type": "banner", "delay": 6, "direction": "ltr", "fadeaway": 100 }
    }
  ]
}
